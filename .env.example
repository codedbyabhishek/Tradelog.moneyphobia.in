# App
NODE_ENV=production
NEXT_PUBLIC_ENABLE_PWA=false

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Site URL
NEXT_PUBLIC_SITE_URL=https://traderlogify.online
ADMIN_EMAILS=you@example.com,team@example.com

# Google Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Traderlogify <support@traderlogify.online>

# Razorpay (India-first billing)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PLAN_MONTHLY_ID=plan_xxxxxxxxxx
RAZORPAY_PLAN_YEARLY_ID=plan_xxxxxxxxxx
